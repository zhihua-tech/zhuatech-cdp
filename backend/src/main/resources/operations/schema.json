{
  "slug": "cdp",
  "title": "授权用途与保留期限复核",
  "fields": [
    {
      "key": "id",
      "label": "记录编号",
      "type": "ID"
    },
    {
      "key": "requestedCustomers",
      "label": "拟导出客户数",
      "type": "NUMBER",
      "scale": 0,
      "min": "1",
      "max": "1000000"
    },
    {
      "key": "purposeConsents",
      "label": "具有本用途授权客户",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "1000000"
    },
    {
      "key": "withdrawn",
      "label": "其中已撤回客户",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "1000000"
    },
    {
      "key": "purposeApproved",
      "label": "本次处理用途已核准",
      "type": "ENUM",
      "options": [
        "YES",
        "NO"
      ]
    },
    {
      "key": "consentUntil",
      "label": "最早同意有效至",
      "type": "DATE"
    },
    {
      "key": "retentionUntil",
      "label": "最早保留有效至",
      "type": "DATE"
    }
  ],
  "columns": [
    {
      "key": "eligibleByDeclaration",
      "label": "声明有效授权客户"
    },
    {
      "key": "authorizationGap",
      "label": "授权缺口"
    },
    {
      "key": "expired",
      "label": "有效期已过"
    }
  ],
  "description": "核对拟导出客户数量中有效授权覆盖、撤回授权及最早保留到期日；不能把一个用途同意当作全部用途许可。",
  "owner": "上海如静知华信息科技有限公司",
  "website": "https://www.zhuatech.cn/",
  "authorization": "商业授权或定制开发请微信添加微信号zhuatech或zhuatech2进行咨询。",
  "version": 1,
  "notes": "输入均须为已获授权的同口径数据。金额固定人民币元；比例为百分数。核算结果只用于复核，未审批、未写库、未发起外部调用，也未触发付款、签名、资料销毁或设备控制。建议不构成法律、安全、会计或碳核证结论。",
